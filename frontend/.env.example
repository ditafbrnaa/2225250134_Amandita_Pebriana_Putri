# Salin menjadi .env lalu sesuaikan.

# Alamat backend FastAPI. Kosongkan untuk menjalankan aplikasi tanpa backend (mode demo/offline penuh).
VITE_API_URL=

# true  → skor dihitung di HP (untuk uji coba tanpa backend). Kunci jawaban IKUT masuk ke bundle.
# false → kunci jawaban TIDAK ikut di-bundle; skor resmi dihitung backend. Pakai false untuk penelitian.
VITE_DEMO_MODE=true
