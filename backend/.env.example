# Salin menjadi .env
DATABASE_URL=sqlite:///./vennbuster.db
# Ganti dengan teks acak panjang (mis. hasil: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=ganti-dengan-teks-rahasia-yang-panjang
# PIN untuk masuk ke Dasbor Guru
TEACHER_PIN=123456
# Alamat frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
