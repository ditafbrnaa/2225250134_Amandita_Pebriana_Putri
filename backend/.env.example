# Salin menjadi .env
DATABASE_URL=sqlite:///./vennbuster.db
# Ganti dengan teks acak panjang (mis. hasil: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=ganti-dengan-teks-rahasia-yang-panjang
# PIN untuk masuk ke Dasbor Guru
TEACHER_PIN=123456
# Alamat frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tutor AI (opsional). Kosongkan AI_API_KEY untuk mematikan tutor.
# Ambil kunci gratis di https://openrouter.ai → Keys → Create Key
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Gratis (bawaan): google/gemma-4-31b-it:free  |  DeepSeek (berbayar, murah): deepseek/deepseek-v4.1-flash
AI_MODEL=google/gemma-4-31b-it:free
